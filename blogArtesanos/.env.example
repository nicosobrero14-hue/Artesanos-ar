# ─────────────────────────────────────────────────────────────────────────
# Variables de entorno para Artesanos.ar — backend Spring Boot
# Copiá este archivo como `.env` y completá los valores reales.
# NUNCA commits el .env real al repositorio.
# ─────────────────────────────────────────────────────────────────────────

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/blogartesanos?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=changeme_db_password

# JWT: SECRETO LARGO Y RANDOM. Generar con: openssl rand -base64 48
# Si lo cambiás en prod, todos los usuarios deberán volver a loguearse.
JWT_SECRET=changeme_minimo_32_caracteres_random_y_no_compartir

# Cloudinary (https://cloudinary.com → Dashboard → API keys)
CL_NAME=changeme_cloud_name
CL_API_KEY=changeme_api_key
CL_SECRET=changeme_api_secret

# Email SMTP (Gmail con App Password, o SendGrid/Mailgun en prod)
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=changeme_app_password_de_16_caracteres

# Admin bootstrap — se crea al startup si no existe
ADMIN_EMAIL=admin@artesanos.ar
ADMIN_PASSWORD=changeme_password_admin_fuerte
ADMIN_NAME=Admin Artesanos

# URLs y CORS
FRONTEND_URL=http://localhost:5173
# Separar múltiples orígenes con coma. Ej: https://artesanos.ar,https://www.artesanos.ar
CORS_ORIGINS=http://localhost:5173

# Schema management
# Dev: update — Hibernate auto-actualiza el schema
# Prod: validate — Hibernate solo valida que el schema coincida con las entities
DDL_AUTO=update

# Logging
# Dev: true para ver el SQL que ejecuta Hibernate
# Prod: false (genera ruido y filtra info de queries)
SHOW_SQL=true
